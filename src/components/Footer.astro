---
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";
const site = yaml.load(
    fs.readFileSync(path.join(process.cwd(), "src/data/site.yaml"), "utf8"),
) as {
    name: string;
    url: string;
};
const siteHost = new URL(site.url).host;
const year = new Date().getFullYear();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<footer class="site-footer">
    <div class="cols">
        <div class="col">
            <span class="lockup">{site.name}</span>
            <p class="managed-by">
                <span>Pagina web gestita da </span>
                <a href="https://motiu.org" target="_blank" rel="noopener">
                    Motiu
                </a>
            </p>
        </div>
        <div class="col">
            <span class="eyebrow">Esplora</span>
            <ul>
                <li>
                    <a href={base}>Home</a>
                </li>
                <li>
                    <a href={`${base}organizations/`}>Organizzazioni</a>
                </li>
                <li>
                    <a href={`${base}programs/`}>Programmi e Iniziative</a>
                </li>
                <li>
                    <a href={`${base}events/`}>Eventi</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="meta">
        <span>
            {site.name} · {siteHost} · {year}
        </span>
        <span>Codice · MIT</span>
        <span>Contenuti · CC BY-SA 4.0</span>
    </div>
</footer>
<style>
    .site-footer {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-top: 1px solid var(--ink);
        padding: var(--space-12) var(--gutter) var(--space-8);
        background: var(--paper);
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--rule);
    }
    .cols,
    .meta {
        position: relative;
        z-index: 1;
    }
    .cols {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: var(--space-8);
        max-width: var(--container-default);
        margin: 0 auto;
    }
    .lockup {
        font-family: var(--serif);
        font-size: 1.1rem;
        color: var(--ink);
        display: block;
    }
    .col p {
        margin: var(--space-2) 0 0;
    }
    .managed-by a {
        color: var(--primary);
        text-decoration: none;
    }
    .managed-by a:hover {
        text-decoration: underline;
    }
    .col ul {
        list-style: none;
        margin: var(--space-2) 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }
    .col a {
        color: var(--rule);
        text-decoration: none;
    }
    .col a:hover {
        color: var(--ink);
    }
    .meta {
        display: flex;
        gap: var(--space-6);
        flex-wrap: wrap;
        max-width: var(--container-default);
        margin: var(--space-10) auto 0;
        padding-top: var(--space-4);
        border-top: 1px dashed var(--rule);
    }
    @media (max-width: 720px) {
        .cols {
            grid-template-columns: 1fr;
        }
    }
</style>
